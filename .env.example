# DocuMind AI - Environment Variables Template
# Copy this file to .env and insert your API keys

# Groq API Key (Free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Default LLM Model (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Hardware Acceleration ('true' for CUDA, 'false' for CPU)
USE_CUDA=false
